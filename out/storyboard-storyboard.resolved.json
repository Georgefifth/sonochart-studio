        {
          "id": "layer_audio",
          "name": "Spatial Web Audio & WAV Encoder",
          "spec": "44.1kHz 16-BIT STEREO PCM",
          "role": "Harmonic scale quantization, stereo panning (-0.85L..+0.85R), and RIFF WAV export",
          "layer": 1.7
        }
